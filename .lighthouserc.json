{
  "ci": {
    "collect": {
      "url": [
        "https://jadolation.github.io/bettermapandan/index.html",
        "https://jadolation.github.io/bettermapandan/services.html",
        "https://jadolation.github.io/bettermapandan/services/business-permit.html",
        "https://jadolation.github.io/bettermapandan/government.html",
        "https://jadolation.github.io/bettermapandan/legislative.html",
        "https://jadolation.github.io/bettermapandan/statistics.html",
        "https://jadolation.github.io/bettermapandan/transparency.html",
        "https://jadolation.github.io/bettermapandan/search.html",
        "https://jadolation.github.io/bettermapandan/support/report.html",
        "https://jadolation.github.io/bettermapandan/about.html",
        "https://jadolation.github.io/bettermapandan/fil/services/business-permit.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage --disable-extensions"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
