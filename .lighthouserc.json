{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 8080 --directory .",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "/index.html",
        "/services.html",
        "/services/business-permit.html",
        "/government.html",
        "/legislative.html",
        "/statistics.html",
        "/transparency.html",
        "/search.html",
        "/support/report.html",
        "/about.html",
        "/fil/services/business-permit.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage --disable-extensions"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
