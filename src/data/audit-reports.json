    "key_findings": [
        {
            "id": "ppe-reconciliation",
            "title": "PPE Account Not Reconciled",
            "description": "Property, Plant & Equipment records not reconciled with subsidiary ledgers. No complete Report on Physical Count of PPE submitted annually. Incomplete ledger cards and property cards.",
            "first_cited": 2014,
            "last_cited": 2019,
            "amount": 90200000,
            "amount_note": "2015 peak; 2014 figure was ₱85,516,514",
            "status": "resolved",
            "category": "Asset Management",
            "severity": "high"
        },
        {
            "id": "breeding-stocks",
            "title": "Breeding Stocks Ghost Account",
